# ==============================================================================
# 外送系統 - 環境變數設定範本 (.env.example)
# 使用方式：請將此檔案複製並命名為 .env，然後依據您的本地開發設定進行修改。
# 注意：請勿將包含真實密碼或金鑰的 .env 檔案提交至 Git 倉庫。
# ==============================================================================

# 1. 系統環境設定 (Server Settings)
APP_ENV=local                              # 運行環境：local (開發環境) / production (正式環境)
HOST=127.0.0.1                             # 綁定 Host IP
PORT=8000                                  # 服務埠號

# 2. 資料庫設定 (Database Configuration)
# 本地開發預設使用 SQLite 檔案庫：
DATABASE_URL=sqlite:///./delivery.db
# 生產環境配置實例 (Render PostgreSQL)：
# DATABASE_URL=postgresql://user:password@hostname:port/dbname

# 3. 安全性設定 (Security Settings)
# 請使用 `openssl rand -hex 32` 產生強固的金鑰：
JWT_SECRET=super_secret_jwt_sign_key_for_local_development_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440           # Token 有效期 (單位：分鐘)，預設為 24 小時

# 4. 外送業務預設設定 (Delivery Settings)
DELIVERY_FEE=39                            # 固定加收之外送費
